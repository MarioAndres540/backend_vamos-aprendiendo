PORT=3000
# En el servidor: production (apaga Swagger)
NODE_ENV=development

# Orígenes del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:4242

# Supabase Credentials
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# JWT Credentials
# Dos valores aleatorios distintos. En producción, mínimo 32 caracteres cada uno (si no, el backend no arranca).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_clave_secreta_jwt
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=tu_clave_secreta_refresh
JWT_REFRESH_EXPIRES_IN=7d
